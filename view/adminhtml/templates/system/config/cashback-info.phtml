/** @var \FlizPay\Payment\Block\Adminhtml\System\Config\CashbackInfo $block */
/** @var \Magento\Framework\Escaper $escaper */

$firstPurchaseRate = $block->getFirstPurchaseRate();
$standardRate = $block->getStandardRate();
?>
<div class="flizpay-discount-info">
    <?php if ($block->hasCashback()): ?>
        <div class="flizpay-discount-info__box flizpay-discount-info__box--info">
            <strong>
                <?= $escaper->escapeHtml(__("Current Discount Rates:")) ?>
            </strong>
            <ul class="flizpay-discount-info__list">
                <?php if ($firstPurchaseRate !== ""): ?>
                    <li>
                        <?= $escaper->escapeHtml(__("First Purchase")) ?>:
                        <?= $escaper->escapeHtml($firstPurchaseRate) ?>%
                    </li>
                <?php endif; ?>
                <?php if ($standardRate !== ""): ?>
                    <li>
                        <?= $escaper->escapeHtml(__("Standard")) ?>:
                        <?= $escaper->escapeHtml($standardRate) ?>%
                    </li>
                <?php endif; ?>
            </ul>
        </div>
    <?php else: ?>
        <div class="flizpay-discount-info__box flizpay-discount-info__box--warning">
            <?= $escaper->escapeHtml(
                __(
                    "No discount is currently configured. Enable discounts in your FLIZpay dashboard to offer savings to your customers.",
                ),
            ) ?>
        </div>
    <?php endif; ?>
    <p class="flizpay-discount-info__configure">
        <?= /* @noEscape */
            __(
                "Configure discount rates in your %1FLIZpay Dashboard%2.",
                '<a href="https://app.flizpay.de/discount" target="_blank" rel="noopener">',
                "</a>",
            ) ?>
    </p>
</div>
