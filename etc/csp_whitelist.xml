 */
 -->
<!--
    Magento enforces a Content Security Policy on the storefront, and its
    default script-src whitelist does not include FLIZpay. Without these
    entries the hosted <fliz-checkout> bundle is blocked before it can
    upgrade the element, and the checkout silently keeps the plain label.
-->
<csp_whitelist
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Csp:etc/csp_whitelist.xsd"
>
    <policies>
        <!-- The hosted bundle that registers the FLIZpay web components. -->
        <policy id="script-src">
            <values>
                <value id="flizpay_app" type="host">app.flizpay.de</value>
                <!-- TODO: remove before shipping. Local business-web bundle. -->
                <value
                    id="flizpay_local_app"
                    type="host"
                >olegs-macbook-pro-1.tail9450f2.ts.net:4441</value>
            </values>
        </policy>
        <!-- The component resolves the shop's offer text from the FLIZpay API. -->
        <policy id="connect-src">
            <values>
                <value id="flizpay_api" type="host">api.flizpay.de</value>
                <!-- TODO: remove before shipping. Local backend. -->
                <value
                    id="flizpay_local_api"
                    type="host"
                >olegs-macbook-pro-1.tail9450f2.ts.net:4440</value>
            </values>
        </policy>
    </policies>
</csp_whitelist>
