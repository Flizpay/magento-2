<config
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd"
>
    <system>
        <tab id="flizpay" translate="label" sortOrder="300" class="flizpay-tab">
            <label>FLIZpay</label>
        </tab>
        <section
            id="flizpay"
            translate="label"
            type="text"
            sortOrder="10"
            showInDefault="1"
            showInWebsite="1"
            showInStore="0"
        >
            <label>Settings</label>
            <tab>flizpay</tab>
            <resource>FlizPay_Payment::config</resource>

            <group
                id="settings"
                translate="label"
                type="text"
                sortOrder="10"
                showInDefault="1"
                showInWebsite="1"
                showInStore="0"
            >
                <label>FLIZpay Settings</label>
                <attribute type="expanded">1</attribute>

                <field
                    id="welcome"
                    translate="label"
                    type="text"
                    sortOrder="10"
                    showInDefault="1"
                    showInWebsite="1"
                >
                    <label>Welcome to FLIZpay!</label>
                    <frontend_model
                    >FlizPay\Payment\Block\Adminhtml\System\Config\Welcome</frontend_model>
                </field>

                <field
                    id="active"
                    translate="label"
                    type="select"
                    sortOrder="15"
                    showInDefault="1"
                    showInWebsite="1"
                    canRestore="1"
                >
                    <label>Enabled</label>
                    <config_path>payment/flizpay/active</config_path>
                    <source_model
                    >Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>

                <field
                    id="heading_api"
                    translate="label"
                    sortOrder="20"
                    showInDefault="1"
                    showInWebsite="1"
                >
                    <label>API Configuration</label>
                    <frontend_model
                    >Magento\Config\Block\System\Config\Form\Field\Heading</frontend_model>
                </field>
                <field
                    id="api_key"
                    translate="label comment"
                    type="obscure"
                    sortOrder="30"
                    showInDefault="1"
                    showInWebsite="0"
                >
                    <label>API Key</label>
                    <comment
                    >Your FLIZpay API key for authentication. Get this from your FLIZpay merchant dashboard.</comment>
                    <config_path>payment/flizpay/api_key</config_path>
                    <backend_model
                    >Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                </field>
                <field
                    id="connection_status"
                    translate="label"
                    type="text"
                    sortOrder="40"
                    showInDefault="1"
                    showInWebsite="0"
                >
                    <label>Connection Status</label>
                    <config_path>payment/flizpay/connection_status</config_path>
                    <frontend_model
                    >FlizPay\Payment\Block\Adminhtml\System\Config\ConnectionStatus</frontend_model>
                </field>

                <field
                    id="heading_checkout"
                    translate="label"
                    sortOrder="60"
                    showInDefault="1"
                    showInWebsite="1"
                >
                    <label>Checkout Settings</label>
                    <frontend_model
                    >Magento\Config\Block\System\Config\Form\Field\Heading</frontend_model>
                </field>
                <field
                    id="preview"
                    translate="label"
                    type="text"
                    sortOrder="70"
                    showInDefault="1"
                    showInWebsite="1"
                >
                    <label>Preview</label>
                    <frontend_model
                    >FlizPay\Payment\Block\Adminhtml\System\Config\CheckoutPreview</frontend_model>
                </field>
                <field
                    id="show_checkout_logo"
                    translate="label comment"
                    type="select"
                    sortOrder="90"
                    showInDefault="1"
                    showInWebsite="1"
                    canRestore="1"
                >
                    <label>Logo</label>
                    <comment>Show FLIZpay logo in checkout.</comment>
                    <config_path
                    >payment/flizpay/show_checkout_logo</config_path>
                    <source_model
                    >Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field
                    id="show_checkout_subtitle"
                    translate="label comment"
                    type="select"
                    sortOrder="100"
                    showInDefault="1"
                    showInWebsite="1"
                    canRestore="1"
                >
                    <label>Subtitle</label>
                    <comment
                    >Show description in subtitle when FLIZpay is selected.</comment>
                    <config_path
                    >payment/flizpay/show_checkout_subtitle</config_path>
                    <source_model
                    >Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>

                <field
                    id="heading_options"
                    translate="label"
                    sortOrder="110"
                    showInDefault="1"
                    showInWebsite="1"
                >
                    <label>Payment Options</label>
                    <frontend_model
                    >Magento\Config\Block\System\Config\Form\Field\Heading</frontend_model>
                </field>
                <field
                    id="logging_enabled"
                    translate="label comment"
                    type="select"
                    sortOrder="120"
                    showInDefault="1"
                    showInWebsite="1"
                >
                    <label>Enable Debug Logging</label>
                    <comment
                    >Enable detailed logging for troubleshooting (disable in production).</comment>
                    <config_path>payment/flizpay/logging_enabled</config_path>
                    <source_model
                    >Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field
                    id="sort_order"
                    translate="label comment"
                    type="text"
                    sortOrder="130"
                    showInDefault="1"
                    showInWebsite="1"
                >
                    <label>Sort Order</label>
                    <comment
                    >Position of FLIZpay in the checkout payment method list. Lower numbers appear first.</comment>
                    <config_path>payment/flizpay/sort_order</config_path>
                    <validate>validate-number</validate>
                </field>

                <field
                    id="heading_cashback"
                    translate="label"
                    sortOrder="140"
                    showInDefault="1"
                    showInWebsite="1"
                >
                    <label>Discount Information</label>
                    <frontend_model
                    >Magento\Config\Block\System\Config\Form\Field\Heading</frontend_model>
                </field>
                <field
                    id="cashback_info"
                    translate="label"
                    type="text"
                    sortOrder="150"
                    showInDefault="1"
                    showInWebsite="1"
                >
                    <label>Current Discount Rates</label>
                    <frontend_model
                    >FlizPay\Payment\Block\Adminhtml\System\Config\CashbackInfo</frontend_model>
                </field>
            </group>
        </section>

        <section id="payment">
            <group
                id="flizpay"
