<?xml version="1.0" ?>
<!--
/**
 * FLIZpay Magento 2
 *
 * This Magento 2 extension enables to process payments with FLIZpay (https://flizpay.de).
 *
 * @package FlizPay_Payment
 * @author  FLIZpay GmbH (https://flizpay.de)
 * @license https://www.gnu.org/licenses/gpl-2.0.txt GPLv2 or later
 * @link    https://flizpay.de
 */
 -->
<schema
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd"
>
    <table name="sales_order">
        <column
            xsi:type="decimal"
            name="flizpay_cashback_amount"
            scale="4"
            precision="20"
            unsigned="false"
            nullable="true"
            comment="FlizPay Cashback Amount"
        />
        <column
            xsi:type="decimal"
            name="base_flizpay_cashback_amount"
            scale="4"
            precision="20"
            unsigned="false"
            nullable="true"
            comment="Base FlizPay Cashback Amount"
        />
        <column
            xsi:type="decimal"
            name="flizpay_original_grand_total"
            scale="4"
            precision="20"
            unsigned="false"
            nullable="true"
            comment="FlizPay Original Grand Total"
        />
        <column
            xsi:type="decimal"
            name="base_flizpay_original_grand_total"
            scale="4"
            precision="20"
            unsigned="false"
            nullable="true"
            comment="Base FlizPay Original Grand Total"
        />
        <column
            xsi:type="decimal"
            name="flizpay_shipping_cashback_amount"
            scale="4"
            precision="20"
            unsigned="false"
            nullable="true"
            comment="FlizPay Shipping Cashback Amount"
        />
        <column
            xsi:type="decimal"
            name="base_flizpay_shipping_cashback_amount"
            scale="4"
            precision="20"
            unsigned="false"
            nullable="true"
            comment="Base FlizPay Shipping Cashback Amount"
        />
    </table>

    <table name="sales_order_item">
        <column
            xsi:type="decimal"
            name="flizpay_cashback_amount"
            scale="4"
            precision="20"
            unsigned="false"
            nullable="true"
            comment="FlizPay Cashback Amount"
        />
        <column
            xsi:type="decimal"
            name="base_flizpay_cashback_amount"
            scale="4"
            precision="20"
            unsigned="false"
            nullable="true"
            comment="Base FlizPay Cashback Amount"
        />
    </table>

    <table name="sales_invoice">
        <column
            xsi:type="decimal"
            name="flizpay_cashback_amount"
            scale="4"
            precision="20"
            unsigned="false"
            nullable="true"
            comment="FlizPay Cashback Amount"
        />
        <column
            xsi:type="decimal"
            name="base_flizpay_cashback_amount"
            scale="4"
            precision="20"
            unsigned="false"
            nullable="true"
            comment="Base FlizPay Cashback Amount"
        />
    </table>

    <table
        name="flizpay_payment_attempt"
        resource="default"
        engine="innodb"
        comment="FlizPay Payment Attempts"
    >
        <column
            xsi:type="int"
            name="entity_id"
            unsigned="true"
            nullable="false"
            identity="true"
            comment="Entity ID"
        />
        <column
            xsi:type="varchar"
            name="attempt_id"
            nullable="false"
            length="64"
            comment="Attempt ID"
        />
        <column
            xsi:type="int"
            name="order_id"
            unsigned="true"
            nullable="false"
            comment="Order ID"
        />
        <column
            xsi:type="varchar"
            name="order_increment_id"
            nullable="false"
            length="32"
            comment="Order Increment ID"
        />
        <column
            xsi:type="int"
            name="quote_id"
            unsigned="true"
            nullable="true"
            comment="Quote ID"
        />
        <column
            xsi:type="smallint"
            name="store_id"
            unsigned="true"
            nullable="false"
            comment="Store ID"
        />
        <column
            xsi:type="varchar"
            name="provider_transaction_id"
            nullable="true"
            length="255"
            comment="Provider Transaction ID"
        />
        <column
            xsi:type="varchar"
            name="provider_reference"
            nullable="true"
            length="255"
            comment="Provider Reference"
        />
        <column
            xsi:type="bigint"
            name="expected_amount_minor"
            unsigned="true"
            nullable="false"
            comment="Expected Amount in Minor Units"
        />
        <column
            xsi:type="varchar"
            name="currency"
            nullable="false"
            length="3"
            comment="Currency"
        />
        <column
            xsi:type="varchar"
            name="provider_status"
            nullable="true"
            length="32"
            comment="Provider Status"
        />
        <column
            xsi:type="varchar"
            name="creation_state"
            nullable="false"
            length="16"
            default="new"
            comment="Creation State"
        />
        <column
            xsi:type="varchar"
            name="safe_error_code"
            nullable="true"
            length="64"
            comment="Safe Error Code"
        />
        <column
            xsi:type="text"
            name="encrypted_success_url"
            nullable="true"
            comment="Encrypted Success URL"
        />
        <column
            xsi:type="text"
            name="encrypted_failure_url"
            nullable="true"
            comment="Encrypted Failure URL"
        />
        <column
            xsi:type="text"
            name="encrypted_redirect_url"
            nullable="true"
            comment="Encrypted Redirect URL"
        />
        <column
            xsi:type="char"
            name="return_token_hash"
            nullable="false"
            length="64"
            comment="Return Token Hash"
        />
        <column
            xsi:type="timestamp"
            name="expires_at"
            nullable="true"
            on_update="false"
            comment="Expires At"
        />
        <column
            xsi:type="timestamp"
            name="created_at"
            nullable="false"
            default="CURRENT_TIMESTAMP"
            on_update="false"
            comment="Created At"
        />
        <column
            xsi:type="timestamp"
            name="updated_at"
            nullable="false"
            default="CURRENT_TIMESTAMP"
            on_update="true"
            comment="Updated At"
        />

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id" />
        </constraint>
        <constraint
            xsi:type="foreign"
            referenceId="FLIZPAY_PAYMENT_ATTEMPT_ORDER_ID_SALES_ORDER_ENTITY_ID"
            table="flizpay_payment_attempt"
            column="order_id"
            referenceTable="sales_order"
            referenceColumn="entity_id"
            onDelete="CASCADE"
        />
        <constraint
            xsi:type="foreign"
            referenceId="FLIZPAY_PAYMENT_ATTEMPT_STORE_ID_STORE_STORE_ID"
            table="flizpay_payment_attempt"
            column="store_id"
            referenceTable="store"
            referenceColumn="store_id"
            onDelete="CASCADE"
        />
        <constraint
            xsi:type="unique"
            referenceId="FLIZPAY_PAYMENT_ATTEMPT_ORDER_ID"
        >
            <column name="order_id" />
        </constraint>
        <constraint
            xsi:type="unique"
            referenceId="FLIZPAY_PAYMENT_ATTEMPT_ATTEMPT_ID"
        >
            <column name="attempt_id" />
        </constraint>
        <constraint
            xsi:type="unique"
            referenceId="FLIZPAY_PAYMENT_ATTEMPT_PROVIDER_TRANSACTION_ID"
        >
            <column name="provider_transaction_id" />
        </constraint>
        <constraint
            xsi:type="unique"
            referenceId="FLIZPAY_PAYMENT_ATTEMPT_PROVIDER_REFERENCE"
        >
            <column name="provider_reference" />
        </constraint>
        <index
            referenceId="FLIZPAY_PAYMENT_ATTEMPT_CREATION_STATE"
            indexType="btree"
        >
            <column name="creation_state" />
        </index>
    </table>
</schema>
